{
  "name": "agentready",
  "version": "0.2.0",
  "description": "Real TinyFish web agents test whether AI shoppers can actually use your website: score, exact stuck step, fixes, and scheduled re-tests.",
  "keywords": [
    "ai-agents",
    "agent-readiness",
    "tinyfish",
    "web-agents",
    "ecommerce",
    "testing",
    "accessibility",
    "monitoring"
  ],
  "homepage": "https://github.com/Manideep-2007-ok/Agent-Ready#readme",
  "bugs": {
    "url": "https://github.com/Manideep-2007-ok/Agent-Ready/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Manideep-2007-ok/Agent-Ready.git"
  },
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,web \"npm run dev -w @agentready/server\" \"npm run dev -w @agentready/web\"",
    "start": "npm start -w @agentready/server",
    "build": "npm run build --workspaces --if-present",
    "test": "node scripts/run-tests.mjs",
    "test:e2e": "node apps/web/e2e/run.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
