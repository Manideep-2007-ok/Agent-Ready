TINYFISH_API_KEY=
TINYFISH_MAX_PARALLEL=2
TINYFISH_MAX_DURATION_SECONDS=150
TINYFISH_MOCK=1
PUBLIC_BASE_URL=
ALERT_WEBHOOK_URL=
LLM_PROVIDER=gemini
LLM_API_KEY=
DEMO_STORE_URL=
PORT=4000
FEATURE_RACE=true
FEATURE_WATCH=true
FEATURE_FIXES_AI=true
FEATURE_CUSTOM_TASK=true
FEATURE_LEADERBOARD=true
# Cost limits (D43): a test stops when its agents have spent this many rupees (0 = no limit), and the server refuses new
# tests once today's spend reaches the daily limit (empty or 0 = no daily limit).
BUDGET_PER_TEST_RUPEES=300
BUDGET_PER_DAY_RUPEES=
# Optional (defaults shown). The server listens on this address only; set 0.0.0.0 to expose it.
# HOST=127.0.0.1
# RATE_LIMIT_PER_MIN=10
# MAX_ACTIVE_TESTS=6
# LOG_LEVEL=silent           # turns the one-line JSON logs off
# AGENTREADY_DATA_DIR=        # where reports and watches are stored (default: data/)
# AGENTREADY_ENV_FILE=        # read this file instead of the repo .env
